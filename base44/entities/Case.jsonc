{
  "name": "Case",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Short title for the case"
    },
    "category": {
      "type": "string",
      "enum": [
        "banking",
        "insurance",
        "tenancy",
        "telco",
        "utilities",
        "government",
        "education",
        "other"
      ],
      "description": "Industry category of the dispute"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "complaint_sent",
        "awaiting_response",
        "response_received",
        "escalation_ready",
        "escalated",
        "resolved",
        "closed"
      ],
      "default": "draft",
      "description": "Current status of the case"
    },
    "organisation_name": {
      "type": "string"
    },
    "organisation_complaints_address": {
      "type": "string"
    },
    "organisation_complaints_email": {
      "type": "string"
    },
    "complaint_handler_name": {
      "type": "string"
    },
    "complainant_name": {
      "type": "string"
    },
    "complainant_address": {
      "type": "string"
    },
    "complainant_email": {
      "type": "string"
    },
    "complainant_phone": {
      "type": "string"
    },
    "account_number": {
      "type": "string"
    },
    "incident_date": {
      "type": "string",
      "format": "date"
    },
    "issue_summary": {
      "type": "string"
    },
    "issue_details": {
      "type": "string"
    },
    "desired_outcome": {
      "type": "string"
    },
    "complaint_letter": {
      "type": "string",
      "description": "1st formal complaint letter"
    },
    "complaint_letter_2": {
      "type": "string",
      "description": "2nd complaint letter (follow-up)"
    },
    "complaint_letter_3": {
      "type": "string",
      "description": "3rd and final internal complaint letter"
    },
    "letter_accept_offer": {
      "type": "string",
      "description": "Letter accepting a settlement offer"
    },
    "letter_deny_offer": {
      "type": "string",
      "description": "Letter rejecting an unsatisfactory offer"
    },
    "letter_escalation": {
      "type": "string",
      "description": "Escalation letter to external body"
    },
    "response_deadline": {
      "type": "string",
      "format": "date"
    },
    "escalation_body": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium"
    },
    "notes": {
      "type": "string"
    },
    "executive_summary": {
      "type": "string",
      "description": "AI-generated executive summary (JSON string)"
    }
  },
  "required": [
    "title",
    "category"
  ]
}