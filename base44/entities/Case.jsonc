{
  "name": "Case",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Short title for the case"
    },
    "category": {
      "type": "string",
      "enum": [
        "banking",
        "insurance",
        "tenancy",
        "telco",
        "utilities",
        "government",
        "education",
        "legal_profession",
        "other"
      ],
      "description": "Industry category of the dispute"
    },
    "state": {
      "type": "string",
      "enum": [
        "federal",
        "NSW",
        "VIC",
        "QLD",
        "SA",
        "WA",
        "TAS",
        "ACT",
        "NT"
      ],
      "description": "Australian state/territory (or federal/national) jurisdiction this dispute falls under. Drives which tribunal, ombudsman, regulator and consumer body apply \u2014 never guess this, it must be user-confirmed."
    },
    "complaint_pathway": {
      "type": "object",
      "description": "Structured, single-source-of-truth escalation pathway for this case, assigned by the authority routing engine based on category + state. All prompts, letters, checklists, and reports must use ONLY this object \u2014 never invent or substitute a different ombudsman/tribunal/regulator.",
      "properties": {
        "internalComplaint": {
          "type": "string",
          "description": "Who to complain to first, internally (e.g. bank's IDR team, landlord/agent)"
        },
        "regulator": {
          "type": "string",
          "description": "Government regulator overseeing this industry/jurisdiction (e.g. ASIC, ACMA, NSW Fair Trading)"
        },
        "ombudsman": {
          "type": "string",
          "description": "Relevant ombudsman scheme (e.g. AFCA, TIO, EWON, NSW Ombudsman) \u2014 blank if not applicable"
        },
        "tribunal": {
          "type": "string",
          "description": "Relevant state/territory tribunal (e.g. NCAT, VCAT, QCAT) \u2014 blank if not applicable"
        },
        "court": {
          "type": "string",
          "description": "Relevant court pathway \u2014 blank if not applicable"
        },
        "supportServices": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Free advocacy/support services relevant to this dispute (e.g. Tenants' Union, Legal Aid)"
        },
        "notes": {
          "type": "string",
          "description": "Any qualifying notes about the pathway (e.g. costs assessment applies, state not yet confirmed)"
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "complaint_sent",
        "awaiting_response",
        "response_received",
        "escalation_ready",
        "escalated",
        "resolved",
        "closed"
      ],
      "default": "draft",
      "description": "Current status of the case"
    },
    "progress_stage": {
      "type": "string",
      "enum": [
        "case_created",
        "first_complaint_sent",
        "awaiting_first_response",
        "first_no_response",
        "second_complaint_sent",
        "awaiting_second_response",
        "second_no_response",
        "third_complaint_sent",
        "awaiting_final_response",
        "final_no_response",
        "escalation_ready",
        "escalated",
        "offer_received",
        "offer_accepted",
        "offer_denied",
        "resolved",
        "closed"
      ],
      "default": "case_created",
      "description": "Granular dispute lifecycle stage"
    },
    "organisation_name": {
      "type": "string"
    },
    "organisation_complaints_address": {
      "type": "string"
    },
    "organisation_complaints_email": {
      "type": "string"
    },
    "complaint_handler_name": {
      "type": "string"
    },
    "complainant_name": {
      "type": "string"
    },
    "complainant_address": {
      "type": "string"
    },
    "complainant_email": {
      "type": "string"
    },
    "complainant_phone": {
      "type": "string"
    },
    "account_number": {
      "type": "string"
    },
    "incident_date": {
      "type": "string",
      "format": "date"
    },
    "issue_summary": {
      "type": "string"
    },
    "issue_details": {
      "type": "string"
    },
    "desired_outcome": {
      "type": "string"
    },
    "complaint_letter": {
      "type": "string",
      "description": "Legacy field \u2014 do not use for LetterSuite"
    },
    "complaint_letter_2": {
      "type": "string",
      "description": "Legacy field \u2014 do not use for LetterSuite"
    },
    "complaint_letter_3": {
      "type": "string",
      "description": "Legacy field \u2014 do not use for LetterSuite"
    },
    "letter_accept_offer": {
      "type": "string",
      "description": "Legacy field \u2014 do not use for LetterSuite"
    },
    "letter_deny_offer": {
      "type": "string",
      "description": "Legacy field \u2014 do not use for LetterSuite"
    },
    "letter_escalation": {
      "type": "string",
      "description": "Legacy field \u2014 do not use for LetterSuite"
    },
    "first_complaint_letter": {
      "type": "string",
      "description": "LetterSuite: 1st formal complaint letter"
    },
    "second_complaint_letter": {
      "type": "string",
      "description": "LetterSuite: 2nd complaint letter (follow-up)"
    },
    "third_complaint_letter": {
      "type": "string",
      "description": "LetterSuite: 3rd and final internal complaint letter"
    },
    "accept_offer_letter": {
      "type": "string",
      "description": "LetterSuite: Letter accepting a settlement offer"
    },
    "deny_offer_letter": {
      "type": "string",
      "description": "LetterSuite: Letter rejecting an unsatisfactory offer"
    },
    "escalation_letter": {
      "type": "string",
      "description": "LetterSuite: Escalation letter to external body"
    },
    "response_deadline": {
      "type": "string",
      "format": "date"
    },
    "escalation_body": {
      "type": "string",
      "description": "Human-readable summary composed from complaint_pathway \u2014 display only, never the source of truth"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium"
    },
    "notes": {
      "type": "string"
    },
    "executive_summary": {
      "type": "string",
      "description": "AI-generated executive summary (JSON string)"
    },
    "creation_request_id": {
      "type": "string",
      "description": "Idempotency key \u2014 UUID generated once per create attempt to prevent duplicate submissions"
    },
    "first_complaint_sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "first_response_received_at": {
      "type": "string",
      "format": "date-time"
    },
    "first_no_response_at": {
      "type": "string",
      "format": "date-time"
    },
    "second_complaint_sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "second_response_received_at": {
      "type": "string",
      "format": "date-time"
    },
    "second_no_response_at": {
      "type": "string",
      "format": "date-time"
    },
    "third_complaint_sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "third_response_received_at": {
      "type": "string",
      "format": "date-time"
    },
    "third_no_response_at": {
      "type": "string",
      "format": "date-time"
    },
    "accept_offer_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the Accept Offer letter was sent (supports retrospective/past dates)"
    },
    "deny_offer_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the Deny Offer letter was sent (supports retrospective/past dates)"
    },
    "escalated_at": {
      "type": "string",
      "format": "date-time"
    },
    "escalation_reference": {
      "type": "string"
    },
    "final_outcome": {
      "type": "string"
    },
    "final_outcome_at": {
      "type": "string",
      "format": "date-time"
    },
    "letter_tracking": {
      "type": "object",
      "description": "Per-letter-type send metadata keyed by letter type (letter1, letter2, letter3, accept_offer, deny_offer, escalation). Each entry: { sentDate, generatedDate, manuallyMarkedSent, status, sentMethod, sentTo, sentNotes, proofOfSendingFileId }. Supports retrospective/past sent dates entered by the user."
    },
    "has_civil_claim_pathway": {
      "type": "boolean",
      "default": false,
      "description": "Legal Profession Complaint only: user has confirmed there is a genuine civil/consumer claim (e.g. costs dispute suitable for the state tribunal), not just a conduct/misconduct complaint. Controls whether the state's civil tribunal is offered as an escalation pathway."
    }
  },
  "required": [
    "title",
    "category"
  ]
}