{
  "name": "Case",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Short title for the case"
    },
    "category": {
      "type": "string",
      "enum": [
        "banking",
        "insurance",
        "tenancy",
        "telco",
        "utilities",
        "other"
      ],
      "description": "Industry category of the dispute"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "complaint_sent",
        "awaiting_response",
        "response_received",
        "escalation_ready",
        "escalated",
        "resolved",
        "closed"
      ],
      "default": "draft",
      "description": "Current status of the case"
    },
    "organisation_name": {
      "type": "string",
      "description": "Name of the organisation the complaint is against"
    },
    "organisation_complaints_address": {
      "type": "string",
      "description": "Postal address of the organisation's complaints department"
    },
    "organisation_complaints_email": {
      "type": "string",
      "description": "Email address of the organisation's complaints department"
    },
    "complaint_handler_name": {
      "type": "string",
      "description": "Name of the person handling the complaint at the organisation"
    },
    "complainant_name": {
      "type": "string",
      "description": "Full name of the complainant"
    },
    "complainant_address": {
      "type": "string",
      "description": "Postal address of the complainant"
    },
    "complainant_email": {
      "type": "string",
      "description": "Email address of the complainant"
    },
    "complainant_phone": {
      "type": "string",
      "description": "Mobile/phone number of the complainant"
    },
    "account_number": {
      "type": "string",
      "description": "Account or policy number"
    },
    "incident_date": {
      "type": "string",
      "format": "date",
      "description": "Date of the incident"
    },
    "issue_summary": {
      "type": "string",
      "description": "Brief summary of the issue"
    },
    "issue_details": {
      "type": "string",
      "description": "Full details of the issue from guided questions"
    },
    "desired_outcome": {
      "type": "string",
      "description": "What the user wants to achieve"
    },
    "complaint_letter": {
      "type": "string",
      "description": "AI-generated complaint letter content"
    },
    "response_deadline": {
      "type": "string",
      "format": "date",
      "description": "Deadline for the organisation to respond"
    },
    "escalation_body": {
      "type": "string",
      "description": "Name of the relevant escalation body"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    }
  },
  "required": [
    "title",
    "category"
  ]
}