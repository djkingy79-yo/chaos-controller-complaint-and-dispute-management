{
  "name": "SyncState",
  "type": "object",
  "properties": {
    "sync_token": {
      "type": "string",
      "description": "Google Calendar sync token for incremental updates"
    },
    "user_id": {
      "type": "string",
      "description": "ID of the user who owns this sync state"
    },
    "last_sync_date": {
      "type": "string",
      "format": "date-time",
      "description": "Last time sync was performed"
    }
  },
  "required": [
    "user_id"
  ]
}