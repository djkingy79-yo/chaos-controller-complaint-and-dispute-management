{
  "name": "MerchantResponse",
  "type": "object",
  "properties": {
    "case_id": {
      "type": "string",
      "description": "ID of the case being responded to"
    },
    "share_id": {
      "type": "string",
      "description": "ID of the CaseShare this response is linked to"
    },
    "merchant_email": {
      "type": "string",
      "description": "Email of the merchant who submitted the response"
    },
    "merchant_name": {
      "type": "string",
      "description": "Name of the merchant/respondent"
    },
    "response_text": {
      "type": "string",
      "description": "The full text of the merchant's response"
    },
    "response_type": {
      "type": "string",
      "enum": [
        "general_response",
        "offer_settlement",
        "deny_claim",
        "request_more_info",
        "escalation_response"
      ],
      "default": "general_response",
      "description": "Type of response being submitted"
    },
    "offer_amount": {
      "type": "string",
      "description": "Settlement offer amount if applicable"
    },
    "is_read": {
      "type": "boolean",
      "default": false,
      "description": "Whether the case owner has read this response"
    }
  },
  "required": [
    "case_id",
    "merchant_email",
    "response_text"
  ]
}